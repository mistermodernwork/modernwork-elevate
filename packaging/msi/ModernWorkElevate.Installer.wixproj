<Project Sdk="WixToolset.Sdk/5.0.2">
  <!--
    MSI für ModernWork Elevate (WiX v5, per-machine).
    Aufruf über build\build.ps1 – dort werden ProductVersion, PublishDir und Plattform gesetzt.
    Manuell:
      dotnet build packaging\msi\ModernWorkElevate.Installer.wixproj -c Release ^
        -p:ProductVersion=1.2.0 -p:PublishDir=artifacts\publish\win-x64 -p:InstallerPlatform=x64
    Nicht Teil der .slnx: das WiX-SDK baut nur unter Windows, Core und Tests sollen auch unter Linux bauen.
  -->
  <PropertyGroup>
    <ProductVersion Condition="'$(ProductVersion)' == ''">1.3.6</ProductVersion>
    <InstallerPlatform Condition="'$(InstallerPlatform)' == ''">x64</InstallerPlatform>
    <PublishDir Condition="'$(PublishDir)' == ''">..\..\artifacts\publish\win-x64\</PublishDir>
    <!-- build.ps1 übergibt den Pfad ohne abschließenden Backslash (Leerzeichen im Pfad, "\" vor dem
         schließenden Anführungszeichen würde es maskieren). Eigene Eigenschaft, weil per Kommandozeile
         gesetzte (globale) Eigenschaften im Projekt nicht überschrieben werden können. -->
    <EpmPublishDir>$([MSBuild]::EnsureTrailingSlash('$(PublishDir)'))</EpmPublishDir>
    <OutputName>ModernWorkElevate-$(ProductVersion)-$(InstallerPlatform)</OutputName>
    <OutputType>Package</OutputType>
    <DefineConstants>ProductVersion=$(ProductVersion);PublishDir=$(EpmPublishDir)</DefineConstants>
    <SuppressValidation>false</SuppressValidation>
    <!-- ICE38/ICE43/ICE57 verlangen für die Startmenü-Verknüpfung einen HKCU-KeyPath. Bei Per-Machine-Paketen
         ein bekanntes False Positive (Begründung in Package.wxs). Alle anderen ICEs bleiben aktiv. -->
    <SuppressIces>ICE38;ICE43;ICE57</SuppressIces>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
  </ItemGroup>
</Project>
