<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Testnamen dürfen Unterstriche enthalten. -->
    <NoWarn>$(NoWarn);CA1707;CA1515;CA2007</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\AppForge.Core\AppForge.Core.csproj" />
    <ProjectReference Include="..\..\src\AppForge.Infrastructure\AppForge.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\AppForge.Signing\AppForge.Signing.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\building-blocks\**\*.yaml" Link="building-blocks\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Snapshots\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
