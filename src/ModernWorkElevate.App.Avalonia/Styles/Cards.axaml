<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Card surface variants. `section` is unusual: it carries NO background
    and NO border — it's a pure spacing/grouping container with a caption.
    `active` is the visually elevated surface for active assignments.
  -->

  <!-- ===== Section (caption + content; no chrome of its own) ===== -->

  <Style Selector="Border.section">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <!-- ===== Settings card (subtle outlined container) =====           -->
  <!-- Used in the Settings slide-in to group TENANTS, APPEARANCE,      -->
  <!-- BEHAVIOR and NOTIFICATIONS into discrete                         -->
  <!-- visually-delineated blocks. Background stays transparent so it   -->
  <!-- inherits the slide-in's Surface1; a 1 px BorderSubtle stroke +   -->
  <!-- rounded corners draws the boundary without conflicting with the  -->
  <!-- Surface2 inner cards (account rows, favourites). -->

  <Style Selector="Border.settings-card">
    <Setter Property="Background" Value="{DynamicResource Surface1Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}" />
    <Setter Property="Padding" Value="16,14" />
  </Style>

  <!-- ===== Card (1.3 redesign) =====                                  -->
  <!-- Windows 11 "layer": raised surface, hairline stroke, 8 px corners, -->
  <!-- no drop shadow. Holds one tenant's eligibilities on the main page.  -->

  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource Surface1Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}" />
    <Setter Property="Padding" Value="4" />
  </Style>

  <!-- ===== Section title (1.3 redesign) =====                         -->
  <!-- Sentence case, semibold, secondary text — Windows 11 Settings     -->
  <!-- style, replacing the earlier ALL-CAPS 10 px captions.            -->

  <Style Selector="TextBlock.section-title">
    <Setter Property="FontSize" Value="{DynamicResource FontSmall}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>

  <!-- ===== Icon glyph =====                                           -->
  <!-- Icons come from the Windows icon font (Segoe Fluent Icons on      -->
  <!-- Windows 11, MDL2 as fallback). Earlier versions drew stroke-style SVG      -->
  <!-- paths as filled PathIcons, which rendered as dots and smudges.     -->

  <Style Selector="TextBlock.glyph">
    <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="TextAlignment" Value="Center" />
  </Style>

  <!-- ===== Search box (1.3 redesign) =====                           -->
  <!-- Windows 11 text-box look: raised fill, hairline, accent stroke    -->
  <!-- while focused.                                                   -->

  <Style Selector="Border.searchbox">
    <Setter Property="Background" Value="{DynamicResource Surface1Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    <Setter Property="Padding" Value="10,1" />
  </Style>
  <Style Selector="Border.searchbox:focus-within">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!-- ===== App badge (header) ===== -->

  <Style Selector="Border.app-badge">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}" />
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
  </Style>

  <!-- ===== Base typography ===== -->

  <!-- :is() so the derived window classes (TrayPopupWindow …) match too. -->
  <Style Selector=":is(Window)">
    <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
  </Style>

  <!-- ===== Active role card ===== -->

  <!-- 1.3: a full accent-tinted card with an accent hairline instead of the earlier
       3 px left bar and coloured shadow. -->
  <Style Selector="Border.active">
    <Setter Property="Background" Value="{DynamicResource SurfaceAccentBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <!-- ===== Eligibility row (interactive list item) =====           -->
  <!-- Idle and hover brushes share the same RGB (Surface2);         -->
  <!-- only alpha animates. Using the default `Transparent` here     -->
  <!-- would interpolate through transparent-white and flash a       -->
  <!-- bright peak before settling on the dark hover colour.         -->

  <Style Selector="Border.row">
    <Setter Property="Background" Value="{DynamicResource HoverIdleSurface2Brush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.row:pointerover">
    <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
  </Style>

  <!-- ===== Popup ScrollViewer ===== -->
  <!-- AllowAutoHide=False switches the Fluent vertical ScrollBar out of
       overlay/auto-hide mode into a permanently-visible docked column that
       takes its own width — content then naturally stops before it instead
       of being chopped by an overlay bar. Padding adds a small breathing
       gap between content and bar so the ✕ remove button etc. don't sit
       flush against the scrollbar thumb. -->
  <Style Selector="ScrollViewer.popup">
    <Setter Property="(ScrollViewer.AllowAutoHide)" Value="False" />
    <Setter Property="Padding" Value="0,0,4,0" />
  </Style>

</Styles>
