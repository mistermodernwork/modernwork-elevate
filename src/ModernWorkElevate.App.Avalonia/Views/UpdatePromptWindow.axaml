<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ModernWorkElevate.AppAvalonia.ViewModels"
        x:Class="ModernWorkElevate.AppAvalonia.Views.UpdatePromptWindow"
        x:DataType="vm:UpdatePromptViewModel"
        Title="ModernWork Elevate — new version available"
        Width="340"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        WindowDecorations="BorderOnly"
        TransparencyLevelHint="None"
        Background="{DynamicResource SurfaceBaseBrush}"
        Topmost="True">

  <!-- Shown only when GitHub has a newer version than the one running — like Rufus,
       nothing appears while the app is current. The app never downloads or runs an
       installer itself: the button opens the release page, and the MSI needs an
       administrator anyway. -->
  <Border Background="{DynamicResource SurfaceBaseBrush}">
    <StackPanel Margin="16,14" Spacing="9">

      <!-- Header: glyph + app name, then the version step. The popup appears unprompted
           over any other app — it has to identify itself. -->
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <TextBlock Classes="glyph" Text="&#xE896;" FontSize="17" Foreground="{DynamicResource AccentBrush}" />
        <TextBlock Text="ModernWork Elevate"
                   FontSize="{DynamicResource FontSubtitle}"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
      </StackPanel>

      <TextBlock Text="{Binding VersionText}"
                 FontSize="{DynamicResource FontSmall}"
                 Foreground="{DynamicResource TextSecondaryBrush}" />

      <TextBlock Text="A new version is available. Your IT may roll it out for you; otherwise download the installer from the release page — installing it needs administrator rights."
                 FontSize="{DynamicResource FontSmall}"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource TextSecondaryBrush}" />

      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Classes="ghost" Content="Later" Click="OnLaterClick" />
        <Button Classes="secondary" Content="Open release page" Click="OnOpenReleasePageClick"
                AutomationProperties.Name="Open the release page on GitHub in your browser" />
      </StackPanel>

    </StackPanel>
  </Border>
</Window>
