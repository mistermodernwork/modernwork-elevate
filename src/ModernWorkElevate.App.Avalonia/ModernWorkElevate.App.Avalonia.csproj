<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <RootNamespace>ModernWorkElevate.AppAvalonia</RootNamespace>
    <AssemblyName>ModernWorkElevate</AssemblyName>
    <!-- Display name shown in Task Manager / Details tab (FileDescription).
         Kept space-separated and decoupled from the hyphenated AssemblyName,
         which must stay valid as the on-disk file name. -->
    <AssemblyTitle>ModernWork Elevate</AssemblyTitle>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Description>Tray app for activating Entra PIM roles and groups without admin rights</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.6" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.15" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>

  <!--
    Microsoft.Toolkit.Uwp.Notifications 7.1.3 pulls System.Drawing.Common 4.7.0
    (CVE-2021-24112 / GHSA-rxg9-xrhp-64gj, NuGet audit NU1904). 4.7.2 is the fixed 4.x release.
  -->
  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="4.7.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ModernWorkElevate.Core\ModernWorkElevate.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <!-- Upload-only logo for the Entra app registration; the app itself never loads it. -->
    <AvaloniaResource Remove="Assets\app-registration-logo.png" />
  </ItemGroup>

  <!-- Release notes ship with the build so the what's-new window works offline.
       Named by version alone (ReleaseNotes.0.9.0.md) — the controller looks up the
       running Major.Minor.Patch, which is what a -local build carries too. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\packaging\release-notes\*.md">
      <LogicalName>ReleaseNotes.%(Filename).md</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="appsettings.local.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('appsettings.local.json')" />
  </ItemGroup>

</Project>
