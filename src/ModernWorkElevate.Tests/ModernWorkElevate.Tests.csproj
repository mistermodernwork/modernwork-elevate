<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <RootNamespace>ModernWorkElevate.Tests</RootNamespace>
    <AssemblyName>ModernWorkElevate.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- xunit v3 test projects are executables running on Microsoft.Testing.Platform;
         `dotnet test` drives them in MTP mode (global.json "test.runner"). -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.MTP" Version="10.1.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.15" />
    <PackageReference Include="Moq" Version="4.21.0" />
    <PackageReference Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ModernWorkElevate.Core\ModernWorkElevate.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Fixtures\**\*.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- The real shipped file, so a test can check what the build actually carries. -->
    <None Include="..\ModernWorkElevate.App.Avalonia\appsettings.json" Link="Shipped\appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Coverage settings for coverlet.MTP: only ModernWorkElevate.Core is measured. -->
    <None Update="testconfig.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
